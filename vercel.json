{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/contact-us/:path*",
      "destination": "/en/contact/",
      "permanent": true
    },
    {
      "source": "/about-us/:path*",
      "destination": "/en/about/",
      "permanent": true
    },
    {
      "source": "/our-portfolio/:path*",
      "destination": "/en/portfolio/",
      "permanent": true
    },
    {
      "source": "/services/:path*",
      "destination": "/en/services/:path*",
      "permanent": true
    },
    {
      "source": "/fr/page-daccueil/:path*",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/fr/contactez-nous/:path*",
      "destination": "/fr/contact/",
      "permanent": true
    },
    {
      "source": "/zh/homepage/:path*",
      "destination": "/zh/",
      "permanent": true
    },
    {
      "source": "/zh/\u4e3b\u9875/:path*",
      "destination": "/zh/",
      "permanent": true
    }
  ]
}